// ACAJ — AI CV Auto Apply Jobs
// Target PostgreSQL schema (PostgreSQL 16 + citext + pgvector). Design only, not yet migrated.
// Rules that the database enforces are listed in docs/06-data-model.md.

Project acaj {
  database_type: 'PostgreSQL'
  Note: 'Schema acaj. Tables are grouped: identity, cv, jobs, market, matching, tailoring, applications, feedback, operations.'
}

// ---------- Enums ----------

Enum user_role {
  CANDIDATE
  ADMIN
}

Enum mail_provider {
  GMAIL
  OUTLOOK
}

Enum connection_status {
  ACTIVE
  REVOKED
  ERROR
}

Enum automation_mode {
  AUTO [note: 'Use tailored CV right away, user reviews later']
  REVIEW_FIRST [note: 'Wait for the user to approve each tailored CV']
}

Enum work_mode {
  ONSITE
  HYBRID
  REMOTE
}

Enum seniority {
  INTERN
  FRESHER
  JUNIOR
  MIDDLE
  SENIOR
}

Enum cv_source {
  UPLOAD_FILE
  UPLOAD_IMAGE
  TEMPLATE_MANUAL
  AI_GENERATED
}

Enum ai_status {
  PENDING
  READY
  NEEDS_REVIEW
  FAILED
}

Enum fact_kind {
  PROFILE
  SUMMARY
  EXPERIENCE
  PROJECT
  EDUCATION
  CERTIFICATE
  SKILL_LIST
}

Enum skill_relation_type {
  PARENT_OF
  RELATED_TO
}

Enum source_kind {
  TOPCV
  LINKEDIN
  COMPANY_SITE
}

Enum posting_status {
  OPEN
  EXPIRED
}

Enum apply_channel {
  FORM
  EMAIL
  MANUAL_ONLY
}

Enum requirement_kind {
  MUST
  NICE
}

Enum insight_kind {
  HIGHLIGHT
  WEAKNESS
  KEYWORD
}

Enum band_dimension {
  LEVEL
  INDUSTRY
}

Enum interview_chance {
  HIGH
  MEDIUM
  LOW
}

Enum provenance {
  ORIGINAL
  REWRITTEN
  INFERRED
}

Enum sentence_state {
  ACTIVE
  EDITED
  REVERTED
}

Enum evidence_type {
  FACT
  INFERENCE
  JD_REQUIREMENT
}

Enum application_mode {
  MANUAL
  AUTO
}

Enum application_status {
  QUEUED
  SUBMITTED
  MANUAL_REQUIRED
  FOLLOWED_UP
  INTERVIEW
  OFFER
  REJECTED
  FAILED
}

Enum message_direction {
  OUTBOUND
  INBOUND
}

Enum message_kind {
  APPLICATION
  FOLLOW_UP
  REPLY
  RECRUITER
}

Enum reply_class {
  INTERVIEW
  OFFER
  REJECTED
  UNKNOWN
}

Enum draft_status {
  DRAFT
  CONFIRMED
  SENT
  DISCARDED
}

Enum outcome {
  INTERVIEW
  OFFER
  REJECTED
  NO_RESPONSE
}

Enum feedback_target {
  MATCH
  SENTENCE
  REPLY_CLASS
  INSIGHT
}

Enum feedback_verdict {
  USEFUL
  NOT_USEFUL
  WRONG_LABEL
}

Enum task_type {
  PARSE_CV
  COLLECT_JOBS
  ANALYZE_JD
  COMPUTE_MARKET
  SCORE_MATCHES
  OPTIMIZE_CV
  SUBMIT_APPLICATION
  SEND_FOLLOW_UP
  POLL_INBOX
  SEND_REPLY
  PURGE_USER
}

Enum task_status {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

Enum audit_action {
  REGISTER
  LOGIN
  LOGOUT
  CV_UPLOAD
  CV_UPDATE
  SENTENCE_REVERT
  TAILORED_APPROVE
  APPLY_MANUAL
  AUTOMATION_CHANGE
  REPLY_CONFIRM
  MAILBOX_CONNECT
  ACCOUNT_DELETE
  SOURCE_CHANGE
  USER_STATUS_CHANGE
  WEIGHTS_CHANGE
}

// ---------- Identity and settings ----------

Table app_users {
  id uuid [pk, default: `gen_random_uuid()`]
  email citext [not null, unique]
  password_hash text [not null, note: 'Argon2 or bcrypt (NFR-SEC-002)']
  full_name varchar(120) [not null]
  role user_role [not null, default: 'CANDIDATE']
  is_active boolean [not null, default: true]
  locale varchar(5) [not null, default: 'vi']
  delete_requested_at timestamptz [note: 'Set by account deletion; data purged within 30 days (BR-023)']
  created_at timestamptz [not null, default: `now()`]
}

Table mailbox_connections {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique, ref: - app_users.id]
  provider mail_provider [not null]
  email_address citext [not null]
  token_encrypted bytea [not null, note: 'OAuth tokens, encrypted at rest (NFR-SEC-006)']
  scopes text[] [not null]
  status connection_status [not null, default: 'ACTIVE']
  connected_at timestamptz [not null, default: `now()`]
}

Table automation_settings {
  user_id uuid [pk, ref: - app_users.id]
  enabled boolean [not null, default: false]
  mode automation_mode [not null, default: 'AUTO']
  min_match_score smallint [not null, default: 70, note: '0–100 (BR-019)']
  daily_limit smallint [not null, default: 20, note: '1–100 (BR-019)']
  follow_up_after_days smallint [not null, default: 5, note: '1–30 (BR-021)']
  max_follow_ups smallint [not null, default: 1, note: '0–3 (BR-021)']
  updated_at timestamptz [not null, default: `now()`]
}

Table automation_excluded_companies {
  user_id uuid [not null, ref: > app_users.id]
  company_id uuid [not null, ref: > companies.id]

  indexes {
    (user_id, company_id) [pk]
    company_id
  }
}

Table system_settings {
  id smallint [pk, default: 1, note: 'Exactly one row']
  weight_skill smallint [not null, default: 40]
  weight_semantic smallint [not null, default: 20]
  weight_experience smallint [not null, default: 25]
  weight_location smallint [not null, default: 15]
  chance_high_min smallint [not null, default: 75]
  chance_medium_min smallint [not null, default: 50]
  skill_gate_cap smallint [not null, default: 39, note: 'Max score when the skill factor is 0 (BR-007)']
  inference_max_depth smallint [not null, default: 2, note: 'BR-008']
  market_min_sample integer [not null, default: 30, note: 'BR-006']
  reply_confidence_min numeric(3,2) [not null, default: 0.80, note: 'BR-014']
  daily_token_quota integer [not null, default: 200000, note: 'Per user (BR-016)']
  weights_version integer [not null, default: 1]
  updated_by uuid [ref: > app_users.id]
  updated_at timestamptz [not null, default: `now()`]
}

// ---------- Lookups and skill taxonomy ----------

Table locations {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(80) [not null, unique]
}

Table industries {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(80) [not null, unique]
}

Table skills {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(80) [not null, unique, note: 'Canonical name, e.g. "React"']
}

Table skill_aliases {
  alias citext [pk, note: 'e.g. "ReactJS", "React.js"']
  skill_id uuid [not null, ref: > skills.id]

  indexes {
    skill_id
  }
}

Table skill_relations {
  from_skill_id uuid [not null, ref: > skills.id]
  to_skill_id uuid [not null, ref: > skills.id]
  type skill_relation_type [not null]

  indexes {
    (from_skill_id, to_skill_id) [pk]
    to_skill_id
  }
}

Table skill_inferences {
  from_skill_id uuid [not null, ref: > skills.id, note: 'A skill the candidate has']
  to_skill_id uuid [not null, ref: > skills.id, note: 'A skill that may be inferred from it']
  depth smallint [not null, note: '1..system_settings.inference_max_depth; recomputed when skill_relations change']
  via_skill_id uuid [ref: > skills.id, note: 'Intermediate skill when depth = 2']

  indexes {
    (from_skill_id, to_skill_id) [pk]
    to_skill_id
    via_skill_id
  }
}

Table courses {
  id uuid [pk, default: `gen_random_uuid()`]
  title varchar(200) [not null]
  provider varchar(120)
  url text
  in_catalog boolean [not null, default: true, note: 'false = suggested by AI, labelled in the UI']
}

Table course_skills {
  course_id uuid [not null, ref: > courses.id]
  skill_id uuid [not null, ref: > skills.id]

  indexes {
    (course_id, skill_id) [pk]
    skill_id
  }
}

// ---------- CV ----------

Table cvs {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > app_users.id]
  source cv_source [not null]
  file_key text [note: 'Object storage key of the uploaded file or image']
  status ai_status [not null, default: 'PENDING', note: 'Extraction status']
  is_primary boolean [not null, default: false, note: 'At most one primary CV per user (partial unique index)']
  target_role varchar(120)
  target_seniority seniority
  target_location_id uuid [ref: > locations.id]
  target_work_mode work_mode
  expected_salary_min integer
  embedding vector(1536)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    target_location_id
  }
}

Table cv_facts {
  id uuid [pk, default: `gen_random_uuid()`]
  cv_id uuid [not null, ref: > cvs.id]
  kind fact_kind [not null]
  position smallint [not null]
  title varchar(200)
  organization varchar(200)
  start_date date
  end_date date
  body text [not null]
  confidence numeric(3,2) [note: 'OCR/extraction confidence 0–1']
  needs_review boolean [not null, default: false]

  indexes {
    (cv_id, position) [unique]
  }
}

Table cv_fact_skills {
  fact_id uuid [not null, ref: > cv_facts.id]
  skill_id uuid [not null, ref: > skills.id]

  indexes {
    (fact_id, skill_id) [pk]
    skill_id
  }
}

Table attachments {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > app_users.id]
  title varchar(120) [not null, note: 'e.g. "TOEIC 750"']
  file_key text [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
  }
}

// ---------- Jobs ----------

Table job_sources {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(80) [not null, unique]
  kind source_kind [not null]
  base_url text [not null]
  enabled boolean [not null, default: true, note: 'Admin can switch off at once (BR-005)']
  requests_per_minute smallint [not null, default: 10]
  last_collected_at timestamptz
}

Table companies {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(200) [not null, unique]
  industry_id uuid [ref: > industries.id]
  website text

  indexes {
    industry_id
  }
}

Table job_postings {
  id uuid [pk, default: `gen_random_uuid()`]
  source_id uuid [not null, ref: > job_sources.id]
  external_id varchar(200) [not null]
  url text [not null]
  title varchar(200) [not null]
  company_id uuid [not null, ref: > companies.id]
  location_id uuid [ref: > locations.id]
  work_mode work_mode
  seniority seniority
  salary_min integer
  salary_max integer
  posted_at timestamptz
  expires_at timestamptz
  status posting_status [not null, default: 'OPEN']
  apply_channel apply_channel [not null]
  apply_email citext
  description text [not null, note: 'Untrusted text (BR-013)']
  analysis_status ai_status [not null, default: 'PENDING']
  embedding vector(1536)
  collected_at timestamptz [not null, default: `now()`]

  indexes {
    (source_id, external_id) [unique, note: 'No duplicate postings (BR-003)']
    company_id
    location_id
    (status, posted_at)
  }
}

Table job_requirements {
  id uuid [pk, default: `gen_random_uuid()`]
  posting_id uuid [not null, ref: > job_postings.id]
  kind requirement_kind [not null]
  skill_id uuid [ref: > skills.id, note: 'NULL when the requirement is not a skill, e.g. years of experience']
  text text [not null]
  years_min smallint
  quote_start integer [not null, note: 'Character offsets into job_postings.description']
  quote_end integer [not null]

  indexes {
    posting_id
    skill_id
  }
}

Table jd_insights {
  id uuid [pk, default: `gen_random_uuid()`]
  posting_id uuid [not null, ref: > job_postings.id]
  kind insight_kind [not null]
  text text [not null]
  quote_start integer [not null, note: 'Every insight points to its quote (BR-009)']
  quote_end integer [not null]

  indexes {
    posting_id
  }
}

// ---------- Market statistics (computed by rules) ----------

Table market_snapshots {
  id uuid [pk, default: `gen_random_uuid()`]
  role_key varchar(120) [not null, note: 'Normalized role, e.g. "backend-developer"']
  seniority seniority [not null]
  location_id uuid [not null, ref: > locations.id]
  computed_at timestamptz [not null, default: `now()`]
  sample_size integer [not null]
  open_postings integer [not null]
  applicants_per_posting numeric(6,1)
  salary_p25 integer
  salary_p50 integer
  salary_p75 integer
  onsite_pct numeric(5,2)
  hybrid_pct numeric(5,2)
  remote_pct numeric(5,2)

  indexes {
    (role_key, seniority, location_id, computed_at) [unique]
    location_id
  }
}

Table market_monthly_postings {
  snapshot_id uuid [not null, ref: > market_snapshots.id]
  month date [not null]
  postings integer [not null]

  indexes {
    (snapshot_id, month) [pk]
  }
}

Table market_location_shares {
  snapshot_id uuid [not null, ref: > market_snapshots.id]
  location_id uuid [not null, ref: > locations.id]
  postings integer [not null]

  indexes {
    (snapshot_id, location_id) [pk]
    location_id
  }
}

Table market_salary_bands {
  snapshot_id uuid [not null, ref: > market_snapshots.id]
  dimension band_dimension [not null]
  band_key varchar(80) [not null, note: 'Seniority name or industry name']
  p25 integer [not null]
  p50 integer [not null]
  p75 integer [not null]
  sample_size integer [not null]

  indexes {
    (snapshot_id, dimension, band_key) [pk]
  }
}

Table market_skill_demand {
  snapshot_id uuid [not null, ref: > market_snapshots.id]
  skill_id uuid [not null, ref: > skills.id]
  share_pct numeric(5,2) [not null, note: 'Share of postings that ask for the skill']

  indexes {
    (snapshot_id, skill_id) [pk]
    skill_id
  }
}

// ---------- Matching (computed by rules) ----------

Table matches {
  id uuid [pk, default: `gen_random_uuid()`]
  cv_id uuid [not null, ref: > cvs.id]
  posting_id uuid [not null, ref: > job_postings.id]
  score smallint [not null, note: '0–100 (BR-007)']
  chance interview_chance [not null, note: 'Primary indicator shown to the user']
  factor_skill numeric(4,3) [not null, note: '0–1']
  factor_semantic numeric(4,3) [not null]
  factor_experience numeric(4,3) [not null]
  factor_location numeric(4,3) [not null]
  weights_version integer [not null]
  computed_at timestamptz [not null, default: `now()`]

  indexes {
    (cv_id, posting_id) [unique]
    posting_id
    (cv_id, chance, score)
  }
}

// ---------- Tailored CV ----------

Table tailored_cvs {
  id uuid [pk, default: `gen_random_uuid()`]
  cv_id uuid [not null, ref: > cvs.id]
  posting_id uuid [not null, ref: > job_postings.id]
  version smallint [not null, default: 1]
  status ai_status [not null, default: 'PENDING']
  ats_passed boolean
  cover_letter text
  pdf_key text
  approved_at timestamptz [note: 'Set in REVIEW_FIRST mode']
  model varchar(80)
  prompt_version varchar(40)
  tokens_in integer
  tokens_out integer
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (cv_id, posting_id, version) [unique]
    posting_id
  }
}

Table tailored_sentences {
  id uuid [pk, default: `gen_random_uuid()`]
  tailored_cv_id uuid [not null, ref: > tailored_cvs.id]
  section fact_kind [not null]
  position smallint [not null]
  text text [not null]
  provenance provenance [not null]
  needs_review boolean [not null, default: false, note: 'Weak evidence; not used when applying']
  state sentence_state [not null, default: 'ACTIVE']
  original_text text [note: 'Text before rewrite, for compare and revert']

  indexes {
    (tailored_cv_id, section, position) [unique]
  }
}

Table tailored_attachments {
  tailored_cv_id uuid [not null, ref: > tailored_cvs.id]
  attachment_id uuid [not null, ref: > attachments.id]

  indexes {
    (tailored_cv_id, attachment_id) [pk]
    attachment_id
  }
}

Table sentence_evidence {
  id uuid [pk, default: `gen_random_uuid()`]
  sentence_id uuid [not null, ref: > tailored_sentences.id]
  type evidence_type [not null]
  fact_id uuid [ref: > cv_facts.id, note: 'Set only when type = FACT']
  inference_from_skill_id uuid [note: 'Set only when type = INFERENCE; with inference_to_skill_id refers to skill_inferences']
  inference_to_skill_id uuid
  requirement_id uuid [ref: > job_requirements.id, note: 'Set only when type = JD_REQUIREMENT']

  indexes {
    sentence_id
    fact_id
    requirement_id
    (inference_from_skill_id, inference_to_skill_id)
  }
}

Ref: sentence_evidence.(inference_from_skill_id, inference_to_skill_id) > skill_inferences.(from_skill_id, to_skill_id)

// ---------- Applications and mail ----------

Table applications {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > app_users.id]
  posting_id uuid [not null, ref: > job_postings.id]
  tailored_cv_id uuid [ref: > tailored_cvs.id]
  mode application_mode [not null]
  status application_status [not null, default: 'QUEUED']
  channel apply_channel
  chance_at_apply interview_chance [not null, note: 'Kept for calibration (BR-024)']
  manual_reason text [note: 'e.g. CAPTCHA (BR-020)']
  submitted_at timestamptz
  follow_up_count smallint [not null, default: 0]
  last_follow_up_at timestamptz

  indexes {
    (user_id, posting_id) [unique, note: 'Never apply twice (BR-018)']
    (user_id, submitted_at)
    posting_id
    tailored_cv_id
  }
}

Table mail_messages {
  id uuid [pk, default: `gen_random_uuid()`]
  application_id uuid [not null, ref: > applications.id]
  direction message_direction [not null]
  kind message_kind [not null]
  provider_message_id varchar(200) [not null, unique, note: 'Idempotent inbox polling']
  thread_id varchar(200)
  from_address citext [not null]
  subject text
  body text [note: 'Untrusted when INBOUND (BR-013)']
  at timestamptz [not null]
  class reply_class [note: 'INBOUND only']
  class_confidence numeric(3,2)
  corrected_class reply_class [note: 'Set when the user fixes the label']

  indexes {
    application_id
  }
}

Table reply_drafts {
  id uuid [pk, default: `gen_random_uuid()`]
  application_id uuid [not null, ref: > applications.id]
  inbound_message_id uuid [not null, unique, ref: - mail_messages.id]
  to_address citext [not null]
  subject text [not null]
  body text [not null]
  status draft_status [not null, default: 'DRAFT']
  confirmed_by uuid [ref: > app_users.id]
  confirmed_at timestamptz [note: 'SENT requires confirmed_by and confirmed_at (BR-022)']
  sent_message_id uuid [ref: - mail_messages.id]

  indexes {
    application_id
    confirmed_by
    sent_message_id
  }
}

Table application_outcomes {
  application_id uuid [pk, ref: - applications.id]
  outcome outcome [not null]
  recorded_at timestamptz [not null, default: `now()`]
}

// ---------- Feedback ----------

Table ai_feedback {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > app_users.id]
  target_type feedback_target [not null]
  target_id uuid [not null]
  verdict feedback_verdict [not null]
  corrected_value text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, target_type, target_id) [unique, note: 'One verdict per user per result; resubmitting replaces it']
    (target_type, target_id)
  }
}

// ---------- Operations ----------

Table tasks {
  id uuid [pk, default: `gen_random_uuid()`]
  type task_type [not null]
  status task_status [not null, default: 'QUEUED']
  user_id uuid [ref: > app_users.id]
  payload jsonb [not null, default: '{}']
  run_after timestamptz [not null, default: `now()`]
  attempts smallint [not null, default: 0]
  max_attempts smallint [not null, default: 3]
  locked_by varchar(80)
  locked_at timestamptz
  last_error text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (status, run_after)
    user_id
  }
}

Table ai_calls {
  id bigserial [pk]
  user_id uuid [ref: > app_users.id]
  task_id uuid [ref: > tasks.id]
  operation varchar(40) [not null, note: 'cv-parse, jd-extract, tailor, classify, draft, embed']
  model varchar(80) [not null]
  prompt_version varchar(40) [not null]
  tokens_in integer [not null]
  tokens_out integer [not null]
  latency_ms integer [not null]
  succeeded boolean [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at)
    task_id
  }
}

Table notifications {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > app_users.id]
  title varchar(200) [not null]
  body text
  link text [note: 'Route in the web app']
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, read_at)
  }
}

Table audit_logs {
  id bigserial [pk]
  user_id uuid [ref: > app_users.id]
  action audit_action [not null]
  entity_type varchar(40)
  entity_id uuid
  details jsonb [note: 'Never contains passwords, tokens or keys (NFR-SEC-005)']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at)
    (entity_type, entity_id)
  }
}
